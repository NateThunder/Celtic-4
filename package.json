{
  "name": "celtic-website-3",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#stem-storage": "./app/lib/stemStorage.ts",
    "#product-catalog": "./app/lib/productCatalog.local.ts",
    "#product-catalog-sync": "./app/lib/productCatalogSync.local.ts",
    "#commerce-backup": "./app/lib/commerceBackup.local.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy:vinext": "npm run deploy",
    "build:worker": "node scripts/prepare-worker-video.mjs && vinext build && node scripts/prepare-worker-assets.mjs",
    "deploy": "npm run build:worker && wrangler deploy --config dist/server/wrangler.json",
    "sync:products": "node scripts/sync-products-to-worker.mjs",
    "verify:product-sync": "node scripts/verify-product-sync.mjs",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.15.0",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "lenis": "^1.3.25",
    "next": "16.1.6",
    "nodemailer": "^7.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "siriwave": "^2.4.0",
    "stripe": "^22.1.1",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "type": "module"
}
